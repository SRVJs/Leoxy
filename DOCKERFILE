# =============== #
# Stage 1: Build  #
# =============== #
FROM golang:1.26.2 AS build

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /leoxy ./app/cli

# =================== #
# Stage 2: Production #
# =================== #
FROM golang:1.26.2

WORKDIR /app

COPY --from=build /leoxy /usr/local/bin/leoxy

EXPOSE 8080

ENTRYPOINT ["leoxy"]
